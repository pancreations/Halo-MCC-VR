+DATA = 0x2F3000
+DATA_VSIZE = 0x200
+VIRTUAL_QUERY_IAT = 0x180208
+GET_MODULE_HANDLE_W_IAT = 0x1800F8
+GET_TICK_COUNT64_IAT = 0x180150
+TITLE_DESCRIPTORS = 0x189040
+ACTIVE_TITLE = 0x2BA6C8
+
+TITLE_SELECT = 0x87FF1
+TITLE_SELECT_LEN = 21
+PRESENT = 0xDF60
+PRESENT1 = 0xE060
