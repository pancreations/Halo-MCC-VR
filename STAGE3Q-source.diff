+        'stage3q_present_common','stage3q_hash_region','stage3q_activity_probe',
+        'stage3q_evidence_table'
+    }
+    if not required <= sy.keys():
+        raise SystemExit('missing Stage3Q symbols: ' + str(required - sy.keys()))
