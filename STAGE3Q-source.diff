+    if grow < 0:
+        raise SystemExit('Stage3Q helper section unexpectedly shrank')
+    if grow:
+        b.extend(b'\0' * grow)
+        size_code = struct.unpack_from('<I', b, pe['opt'] + 4)[0]
+        struct.pack_into('<I', b, pe['opt'] + 4, size_code + grow)
