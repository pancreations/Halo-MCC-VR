+// --------------------------------------------------------------------------
+stage3x_h4_hud_install:
+    push rbx
+    push rsi
+    sub rsp, 0x48
+    mov rbx, rcx
+    xor esi, esi
+    test rbx, rbx
+    jz .hud_install_done
+    lea rdx, [rbx + H4_HUD_SITE]
+    mov QWORD PTR [rsp+0x20], rdx
